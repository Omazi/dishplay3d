"Place one dish on a clear, well-lit table." = "Posez un plat sur une table dégagée et bien éclairée.";
"Review scan" = "Vérifier le scan";
"Resume scan" = "Reprendre le scan";
"Scan a missing area" = "Compléter une zone";
"Continue" = "Continuer";
"Back to my dish" = "Retour à mon plat";
