{
  "name": "dishplay",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/low-memory.mjs node --max-old-space-size=768 node_modules/next/dist/bin/next dev --webpack --hostname 127.0.0.1",
    "build": "node scripts/low-memory.mjs node --max-old-space-size=1024 node_modules/next/dist/bin/next build --webpack",
    "start": "node --max-old-space-size=512 node_modules/next/dist/bin/next start --hostname 127.0.0.1",
    "typecheck": "node --max-old-space-size=512 node_modules/next/dist/bin/next typegen && node --max-old-space-size=512 node_modules/typescript/bin/tsc --noEmit",
    "test": "node --max-old-space-size=512 --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "playwright test --workers=1",
    "check": "npm run typecheck && npm test",
    "worker:doctor": "python3 worker/reconstruct.py --doctor"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@google/model-viewer": "4.3.1",
    "fflate": "0.8.2",
    "lucide-react": "1.46.0",
    "next": "16.3.5",
    "pg": "8.23.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.5",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  }
}
