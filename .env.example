# Local development works with persistent PGlite; no Docker or cloud account needed.
# Vercel requires a durable PostgreSQL connection. Never use local files as cloud DB.
DATABASE_URL=
# Explicitly permit creating accounts on a deployed pilot. Disable after onboarding.
ALLOW_SIGNUP=false
# Optional canonical HTTPS origin for CSRF checks and QR links.
NEXT_PUBLIC_APP_URL=
# Import models only from an origin controlled by the operator. No arbitrary fetch.
MEDIA_PUBLIC_ORIGIN=
# Only for a local production build (npm start), never on Vercel:
ALLOW_LOCAL_DATABASE=false
PGLITE_DATA_DIR=.data/dishplay
# Reconstruction is opt-in. A separate Linux worker and pinned engines are required.
ENABLE_RECONSTRUCTION=false
# Worker-only settings (never start the worker inside Vercel functions).
WORKER_DATA_DIR=.data/worker
WORKER_MAX_IMAGES=24
WORKER_MEMORY_MIB=1536
WORKER_LONG_EDGE=1600
WORKER_STAGE_SECONDS=900
WORKER_JOB_SECONDS=3600
